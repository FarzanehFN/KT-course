    "# 3) AM-Modulator (Python-Implementierung)\n",
    "m = 0.6  # Modulationsgrad für U_m = 1.0\n",
    "\n",
    "# IMPLEMENTIERE den Amplitudenmodulator gemäß den bekannten Formeln\n",
