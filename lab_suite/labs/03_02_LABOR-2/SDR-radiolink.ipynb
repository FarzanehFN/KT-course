    "# hier Messung und Spektralanalyse durchführen\n",
    "\n",
    "data = np.load(\"/Users/fn/Git/KT-course/lab_suite/labs/03_02_LABOR-2/sdr_logs/sdr_lab_check.npz\")\n",
    "samples = data[\"samples\"]\n",
    "\n",
    "N = NUM_SAMPLES\n",
    "M = NUM_AVERAGES\n",
    "\n",
    "spectra = []\n",
    "\n",
    "for i in range(M):\n",
    "    segment = samples[i*N:(i+1)*N]\n",
    "    window = np.hanning(N)\n",
    "    spectrum = np.fft.fftshift(np.fft.fft(segment * window))\n",
    "    \n",
    "    magnitude = np.abs(spectrum)\n",
    "    spectra.append(magnitude)\n",
    "\n",
    "# Mittelwert\n",
    "avg_spectrum = np.mean(spectra, axis=0)\n",
    "\n",
    "# dB (numerisch)\n",
    "magnitude_dB_raw = 20 * np.log10(avg_spectrum + 1e-12)\n",
    "magnitude_dBm_cal = magnitude_dB_raw + offset_dB\n",
    "\n",
    "# Frequenzachse\n",
    "freq = np.fft.fftshift(np.fft.fftfreq(N, d=1/SAMPLE_RATE_HZ))\n",
    "freq_mhz = freq / 1e6\n",
    "\n",
    "\n",
    "#folgende Größen sind zu ermitteln (ersetze die Platzhalter):\n",
    "\n",
    "bin_bandwidth_hz = SAMPLE_RATE_HZ / NUM_SAMPLES\n",
    "\n",
    "peak_bin = np.argmax(magnitude_dB_raw)\n",
    "peak_freq_hz = freq[peak_bin]\n",
    "\n",
    "carrier_dBm = magnitude_dB_raw[peak_bin] + offset_dB\n",
    "\n",
    "noise_floor = np.median(magnitude_dB_raw)\n",
    "\n",
    "N0_dBm_per_Hz = noise_floor + offset_dB - 10*np.log10(bin_bandwidth_hz)\n",
    "\n",
    "CN0_dBHz = carrier_dBm - N0_dBm_per_Hz\n",
    " \n",
    "\n",
    "print(f\"Bin-Bandbreite (FFT-Auflösung): {bin_bandwidth_hz:.1f} Hz\")\n",
    "print(f\"Peak bei Bin {peak_bin}, Frequenz {peak_freq_hz/1e6:.6f} MHz\")\n",
    "print(f\"Trägerleistung (kalibriert): {carrier_dBm:.2f} dBm\")\n",
    "print(f\"Rauschleistungsdichte N0: {N0_dBm_per_Hz:.2f} dBm/Hz\")\n",
    "print(f\"C/N0 = {CN0_dBHz:.2f} dB-Hz\")\n",
    "\n",
    "# folgende Ergebnisse für berechnetes und kalibriertes Betragsspektrum sin zu ermitteln: magnitude_dB_raw und magnitude_dBm_cal"
   ]
